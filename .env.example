# Unguard Environment Configuration
# Copy this file to .env and modify values as needed

# Database Configuration
DB_ROOT_PASSWORD=unguard
DB_PASSWORD=unguard123
MARIADB_DATABASE=unguard
MARIADB_USER=unguard

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production

# Service URLs (for docker-compose)
MARIADB_HOST=mariadb
REDIS_HOST=redis
OLLAMA_BASE_URL=http://ollama:11434

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080

# Logging
LOG_LEVEL=info

# Feature Flags
ENABLE_TRACING=true
ENABLE_RAG_SERVICE=false

# Load Generation
ENABLE_USER_SIMULATOR=true
USER_SIMULATOR_INTERVAL=30000
