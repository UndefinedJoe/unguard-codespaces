{
  "name": "Unguard - Vulnerable Microservices Demo",
  "image": "mcr.microsoft.com/devcontainers/universal:latest",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {},
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {},
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "secrets": {
    "DT_URL": {
      "description": "eg. https://abc12345.live.dynatrace.com"
    },
    "DT_TOKEN": {
      "description": "Dynatrace DataIngest token with these permissions: Ingest metrics, Ingest logs, Ingest events, Ingest OpenTelemetry, Read metrics, Write settings",
      "documentationUrl": "https://docs.dynatrace.com/docs/shortlink/api-authentication"
    },
    "DT_OPERATOR_TOKEN": {
      "description": "Dynatrace API token with these permissions: Create ActiveGate token, Read entities, Read Settings, Write Settings, Access problem and event feed, metrics and topology, Read configuration, Write configuration, Paas integration - installer downloader"
    }
  },
  "remoteUser": "root",
  "runArgs": [
    "--privileged"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "ms-vscode-remote.remote-containers",
        "ms-vscode.makefile-tools",
        "ms-vscode-docker.remote-containers",
        "charliermarsh.ruff",
        "golang.go",
        "ms-vscode.cpptools-extension-pack",
        "ms-dotnettools.csharp",
        "vscjava.extension-pack-for-java",
        "felipecaputo.git-project-manager"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/bin/python3",
        "python.linting.enabled": true,
        "python.linting.pylintEnabled": true,
        "python.formatting.provider": "black",
        "[go]": {
          "editor.formatOnSave": true,
          "editor.defaultFormatter": "golang.go"
        },
        "[java]": {
          "editor.defaultFormatter": "redhat.java"
        }
      }
    }
  },
  "postCreateCommand": "/bin/bash .devcontainer/post-create.sh",
  "postStartCommand": "/bin/bash .devcontainer/post-start.sh",
  "forwardPorts": [80, 443, 3000, 8080],
  "portsAttributes": {
    "80": {
      "label": "Unguard Frontend (HTTP)",
      "onAutoForward": "notify"
    },
    "443": {
      "label": "Unguard Frontend (HTTPS)",
      "onAutoForward": "notify"
    },
    "3000": {
      "label": "Frontend (Docker Compose)",
      "onAutoForward": "notify"
    },
    "8080": {
      "label": "API Gateway",
      "onAutoForward": "notify"
    }
  },
  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ]
}
